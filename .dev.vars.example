# Copy to .dev.vars for local dev. Production values: `wrangler secret put NAME`.
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=xoxb-
# Optional, for the create_code_channel MCP tool: a Slack browser session's xoxc token and `d` cookie.
SLACK_CLIENT_TOKEN=
SLACK_D_COOKIE=
# Optional, for the Gmail draft tools: a Google OAuth client (see README, Gmail drafts).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional, for Slack workspaces besides the home one (see README, Adding a second workspace):
# base64 of 32 random bytes, `openssl rand -base64 32`.
PIP_SECRETS_KEY=
