{
  "name": "pip",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && pnpm run release",
    "migrate": "wrangler d1 migrations apply pip --remote",
    "release": "pnpm run migrate && wrangler deploy",
    "types": "wrangler types --strict-vars=false",
    "typecheck": "tsc -b",
    "lint": "biome check",
    "format": "biome check --write",
    "test": "vitest run",
    "mcp:stdio": "node src/entry/stdio.ts",
    "inspect": "pnpm dlx @modelcontextprotocol/inspector node src/entry/stdio.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "@tanstack/react-router": "^1.170.42",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "slack-edge": "^1.3.17",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@cloudflare/vite-plugin": "^1.63.1",
    "@cloudflare/vitest-plugin": "^1.4.8",
    "@tanstack/router-plugin": "^1.168.43",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "^4.153.0"
  }
}
